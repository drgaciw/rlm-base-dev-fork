{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * main)",
      "mcp__salesforce__deploy_metadata",
      "mcp__salesforce__assign_permission_set",
      "mcp__salesforce__delete_org"
    ],
    "ask": [
      "Bash(cci flow run *)",
      "Bash(sf project deploy *)",
      "Bash(git push *)",
      "PowerShell(cci flow run *)",
      "PowerShell(sf project deploy *)",
      "PowerShell(git push *)"
    ],
    "allow": [
      "Bash(python scripts/ai/pr_gate.py *)",
      "Bash(python scripts/ai/analyze_agent_tooling.py check*)",
      "Bash(cci task info *)",
      "Bash(cci flow info *)",
      "PowerShell(python scripts/ai/pr_gate.py *)",
      "PowerShell(python scripts/ai/analyze_agent_tooling.py check*)",
      "PowerShell(cci task info *)",
      "PowerShell(cci flow info *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_python.sh\" protect_generated.py error"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_python.sh\" session_start_skill_check.py warn"
          }
        ]
      }
    ]
  }
}
