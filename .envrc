# Project env for rlm-base-dev. Activated by direnv on entry; deactivated on exit.
# Requires: brew install direnv ; eval "$(direnv hook zsh)" in ~/.zshrc.

# ── Python via pyenv ─────────────────────────────────────────────────────────
# Pin to the 3.13 major.minor line; auto-resolve to the latest installed patch.
# To install a new 3.13.x patch, run `scripts/bash/update-toolchain.sh` — it
# resolves the latest patch in the line, installs it, and reinstalls the CCI
# pipx venv under the new Python (the venv's python symlink breaks otherwise).
# Manual equivalent: `pyenv install $(pyenv latest -k 3.13)`.
if command -v pyenv >/dev/null 2>&1; then
  _PY_RESOLVED="$(pyenv latest 3.13 2>/dev/null)"
  if [ -n "$_PY_RESOLVED" ]; then
    export PYENV_VERSION="$_PY_RESOLVED"
    PATH_add "$(pyenv root)/shims"
  else
    echo ".envrc: no Python 3.13.x installed via pyenv. Run scripts/bash/update-toolchain.sh or 'pyenv install \$(pyenv latest -k 3.13)' to install the latest patch." >&2
  fi
  unset _PY_RESOLVED
fi

# ── Node via nvm ─────────────────────────────────────────────────────────────
# `lts/*` tracks whichever line is currently the active LTS (today: Node 24).
# When the next LTS lands, `nvm install --lts` + this line keeps you current.
# nvm path is resolved via `brew --prefix nvm` to work on both Apple Silicon
# (`/opt/homebrew`) and Intel macOS (`/usr/local`) — matches the README pattern.
export NVM_DIR="$HOME/.nvm"
_NVM_PREFIX="$(brew --prefix nvm 2>/dev/null || true)"
if [ -n "$_NVM_PREFIX" ] && [ -s "$_NVM_PREFIX/nvm.sh" ]; then
  . "$_NVM_PREFIX/nvm.sh" --no-use
  nvm use --silent lts/\* >/dev/null 2>&1 || nvm use --silent default >/dev/null 2>&1
fi
unset _NVM_PREFIX

# ── Salesforce CLI token redaction opt-out ───────────────────────────────────
# As of the May 2026 CLI security change (forcedotcom/cli#3560), `sf` redacts
# access tokens from the --json output of `org create scratch`, `org display`,
# `org list`, the `org login *` commands, etc. CumulusCI 4.10.x still parses
# those outputs for the token, so without this it grabs the literal
# "[REDACTED] Use 'sf org auth show-access-token' to view." placeholder and
# sends it as the auth header → `INVALID_AUTH_HEADER` / "Expired session" on
# `cci org info`, scratch creation, and most org tasks.
#
# SF_TEMP_SHOW_SECRETS=true restores the legacy output so CCI can read the
# token. This is a TEMPORARY Salesforce-provided shim. Salesforce originally
# signalled removal in Summer '26 (262), but it still works as of Release 264 —
# the durable fix is a CumulusCI release that calls
# `sf org auth show-access-token --json`. Re-check each release; remove this
# once CCI handles it.
#
# A `cci() { ...; }; export -f cci` wrapper was tried here so the var would
# apply only to `cci`, not `sf` calls made directly — but direnv exports
# *variables* into the shell environment it hands back to the parent, not
# function definitions, so `export -f` never actually propagated: the
# wrapper existed only inside the short-lived subshell direnv sources .envrc
# in, and every interactive `cci` call in the real shell still hit the
# redaction bug this exists to work around.
#
# So: exported for the whole direnv-activated shell instead, same as
# .github/workflows/prepare-rlm-org.yml except scoped to "while this repo
# directory is active" rather than to individual steps. That is coarser —
# `sf` invoked directly also loses redaction here, not just `cci` — but it is
# a `direnv edit`-visible, per-project opt-in rather than a shell-wide export,
# and it is honest about what direnv can and can't propagate. Remove this
# whole block once CumulusCI reads the token via `sf org auth
# show-access-token` (see the note above).
export SF_TEMP_SHOW_SECRETS=true
