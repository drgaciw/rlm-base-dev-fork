# Single source of truth for pinned tool versions across CI, the Docker build
# environment, and local tooling. Consumed by:
#   - docker/Dockerfile (build args, passed by .github/workflows/docker-publish.yml)
#   - .github/workflows/prepare-rlm-org.yml
#   - scripts/ai/pr_gate.py (CumulusCI floor check) — wired by WP-10
#
# Plain KEY=VALUE, sourceable with `set -a; . config/tool-versions.env; set +a`
# locally. In a workflow step, do NOT `cat` this straight into $GITHUB_ENV —
# GitHub Actions' environment file requires every non-blank line to be
# `NAME=VALUE` (or a `NAME<<DELIMITER` block), so a `#` comment line with no
# `=` fails the step with "Invalid format". Strip comments/blank lines first:
#   grep -E '^[A-Za-z_][A-Za-z0-9_]*=' config/tool-versions.env >> "$GITHUB_ENV"
# Keep each bump to one PR so drift stays visible in git blame.

# CumulusCI. See docker/Dockerfile and prepare-rlm-org.yml for the history of
# why this floor moved (4.0.0 doc floor vs. this pin).
CUMULUSCI_VERSION=4.8.1

# Salesforce CLI (npm @salesforce/cli). Bumped 2026-06 for the agent-activate
# path that 264's prepare_agents flow reaches.
SF_CLI_VERSION=2.147.7

# SFDMU plugin. Matches validate_setup's required_sfdmu_version floor
# (5.6.4); pinned exact here rather than left as a floor.
SFDMU_VERSION=5.8.0

# Node.js. Pinned to an exact 24.x minor: 24.17.0 broke `sf org login`
# ("Detected unsettled top-level await"). Re-float once a newer 24.x or the
# sf CLI restores compatibility — see prepare-rlm-org.yml and
# check-cci-token-fix.yml.
NODE_VERSION=24.16.0

# Python. Matches the base image tag in docker/Dockerfile and the
# actions/setup-python pin in every workflow. The repo's documented floor is
# 3.11 (pyproject.toml [tool.build_harness]); this is the version CI and the
# image actually run.
PYTHON_VERSION=3.13
